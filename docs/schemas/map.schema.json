{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Leomaradan/minecraft-map-generator/main/docs/schemas/map.schema.json",
  "title": "Map Generator map.json",
  "description": "World configuration of a map ZIP. Every field is optional. See docs/FORMAT.md.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$",
      "description": "Resource id; without a namespace, minecraft: is used."
    },
    "snow": {
      "description": "Where snow layers and ice may form. Snow still needs a biome cold enough at that height: this only removes snow.",
      "oneOf": [
        {
          "type": "boolean",
          "description": "true: snow wherever the biome is cold enough. false: no snow and no ice."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_y": {
              "type": "integer",
              "description": "Lowest Y with snow."
            },
            "max_y": {
              "type": "integer",
              "description": "Highest Y with snow."
            }
          }
        }
      ]
    },
    "block_choice": {
      "oneOf": [
        {
          "$ref": "#/$defs/resource_id"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block"
          ],
          "properties": {
            "block": {
              "$ref": "#/$defs/resource_id"
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1,
              "description": "Relative probability. A plain block id has a weight of 1."
            }
          }
        }
      ]
    },
    "blocks": {
      "description": "A block id, a list of blocks picked at random (with optional weights), or {\"blocks\": [...], \"method\": ...}.",
      "oneOf": [
        {
          "$ref": "#/$defs/resource_id"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block_choice"
          },
          "description": "Blocks picked at random for each position."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocks"
          ],
          "properties": {
            "blocks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/block_choice"
              }
            },
            "method": {
              "enum": [
                "random",
                "perlin"
              ],
              "default": "random",
              "description": "random: each block picked independently. perlin: smooth noise, the blocks form patches about scale blocks wide."
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 16,
              "description": "Size of the perlin patches, in blocks."
            }
          }
        }
      ]
    },
    "features": {
      "description": "Biome features (trees, grass, ores, lakes...): true, false, or a filter.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "disabled": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource_id"
              },
              "description": "Placed features to skip, e.g. minecraft:lake_lava_surface."
            },
            "disabled_steps": {
              "type": "array",
              "items": {
                "enum": [
                  "raw_generation",
                  "lakes",
                  "local_modifications",
                  "underground_structures",
                  "surface_structures",
                  "strongholds",
                  "underground_ores",
                  "underground_decoration",
                  "fluid_springs",
                  "vegetal_decoration",
                  "top_layer_modification"
                ]
              },
              "description": "Generation steps to skip entirely, e.g. lakes."
            },
            "only": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource_id"
              },
              "description": "If set, only these placed features are generated."
            }
          }
        }
      ]
    },
    "carvers": {
      "description": "Caves and ravines from the biomes: true, false, or {\"cave\": ..., \"canyon\": ..., \"noise\": ...}.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cave": {
              "type": "boolean",
              "default": true,
              "description": "Caves (and nether caves)."
            },
            "canyon": {
              "type": "boolean",
              "default": true,
              "description": "Ravines."
            },
            "noise": {
              "type": "boolean",
              "description": "Noise caves: large caverns, spaghetti and noodle caves, cave entrances. Defaults to the value of cave."
            }
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "default": 1,
      "description": "Format version of the map ZIP."
    },
    "name": {
      "type": "string",
      "description": "Name shown in the UI and logs. Defaults to the ZIP file name."
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paths inside the ZIP. Each file defaults to its standard name (heightmap.png, biomes.png...); a file named here must be in the ZIP, and its standard name is then ignored.",
      "properties": {
        "heightmap": {
          "type": "string",
          "default": "heightmap.png",
          "description": "Heightmap file. Required in the ZIP: heightmap.png unless another file is named here.",
          "minLength": 1
        },
        "biomes": {
          "type": "string",
          "default": "biomes.png",
          "description": "Biome map file. Optional under its default name; required in the ZIP when named here.",
          "minLength": 1
        },
        "biome_mapping": {
          "type": "string",
          "default": "biomes.json",
          "description": "Biome mapping file. Optional under its default name; required in the ZIP when named here.",
          "minLength": 1
        },
        "water": {
          "type": "string",
          "default": "water.png",
          "description": "Water map file. Optional under its default name; required in the ZIP when named here.",
          "minLength": 1
        },
        "lava": {
          "type": "string",
          "default": "lava.png",
          "description": "Lava map file. Optional under its default name; required in the ZIP when named here.",
          "minLength": 1
        },
        "structures": {
          "type": "string",
          "default": "structures.json",
          "description": "Structure list file. Optional under its default name; required in the ZIP when named here.",
          "minLength": 1
        },
        "datapack": {
          "type": "string",
          "default": "datapack/",
          "description": "Folder of the embedded datapack; empty to disable."
        }
      }
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "World [X, Z] of pixel (0, 0). Centered on 0, 0 by default."
    },
    "horizontal_scale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1024,
      "default": 1,
      "description": "Blocks per pixel."
    },
    "height": {
      "description": "Pixel value to Y mapping.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_y": {
              "type": "number"
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "description": "y = base_y + value * scale"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_y",
            "max_y"
          ],
          "properties": {
            "min_y": {
              "type": "number"
            },
            "max_y": {
              "type": "number"
            }
          },
          "description": "The full value range maps onto [min_y, max_y]."
        }
      ]
    },
    "dimension_parameter": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit world height (multiples of 16). Automatic by default.",
      "properties": {
        "min_y": {
          "type": "integer",
          "multipleOf": 16
        },
        "height": {
          "type": "integer",
          "multipleOf": 16
        },
        "max_y": {
          "type": "integer",
          "multipleOf": 16
        }
      },
      "not": {
        "required": [
          "height",
          "max_y"
        ]
      }
    },
    "sea_level": {
      "type": "integer",
      "default": 63,
      "description": "Minecraft's sea level. Does not add water."
    },
    "biome_transition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64,
      "default": 4,
      "description": "Biome borders are shifted by up to this many blocks with a smooth noise, so they follow natural curves instead of pixel edges. 0 keeps the exact pixel borders."
    },
    "outside": {
      "type": "object",
      "additionalProperties": false,
      "description": "What is generated around the map.",
      "properties": {
        "mode": {
          "enum": [
            "flat",
            "void",
            "extend"
          ],
          "default": "flat"
        },
        "ground_level": {
          "type": "integer",
          "default": 64
        },
        "water_level": {
          "type": "integer",
          "default": 63
        },
        "biome": {
          "$ref": "#/$defs/resource_id",
          "default": "minecraft:plains"
        },
        "border": {
          "type": "boolean",
          "default": true,
          "description": "Put a world border around the map when the world is created (a square fitting the longest side, centered on the map)."
        }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "z"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "z": {
          "type": "integer"
        },
        "y": {
          "type": "integer",
          "description": "Omit to spawn on the surface."
        }
      }
    },
    "blocks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/blocks",
          "default": "minecraft:stone",
          "description": "Blocks under the surface layers."
        },
        "bedrock": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "decoration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "$ref": "#/$defs/features",
          "default": true,
          "description": "Biome features (trees, grass, ores, lakes...): true, false, or a filter. An entry of biomes.json can override it."
        },
        "carvers": {
          "$ref": "#/$defs/carvers",
          "default": true,
          "description": "Caves and ravines from the biomes: true, false, or {\"cave\", \"canyon\", \"noise\"}. An entry of biomes.json can override it."
        }
      }
    },
    "snow": {
      "$ref": "#/$defs/snow",
      "default": true,
      "description": "Where snow layers and ice may form, for the whole map. Minecraft's biomes get colder above sea_level + 17, so tall maps get snow everywhere: use min_y to keep it on the peaks. An entry of biomes.json can override it."
    },
    "vanilla_structures": {
      "default": true,
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "disabled": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource_id"
              },
              "description": "Structures or structure sets to turn off."
            },
            "only": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/resource_id"
                  },
                  "description": "If set, only these structures or structure sets are generated."
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
