{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Leomaradan/minecraft-map-generator/main/docs/schemas/biomes.schema.json",
  "title": "Map Generator biomes.json",
  "description": "Maps each color of biomes.png to a biome. Keys are colors: #RRGGBB, RRGGBB, 0xRRGGBB or r,g,b.",
  "type": "object",
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$",
      "description": "Resource id; without a namespace, minecraft: is used."
    },
    "substitute": {
      "description": "A biome id, or an object with the biome and its own surface blocks.",
      "oneOf": [
        {
          "$ref": "#/$defs/resource_id"
        },
        {
          "$ref": "#/$defs/variant"
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biome"
      ],
      "properties": {
        "biome": {
          "$ref": "#/$defs/resource_id"
        },
        "top": {
          "$ref": "#/$defs/blocks",
          "description": "Surface blocks."
        },
        "filler": {
          "$ref": "#/$defs/blocks",
          "description": "Blocks under the surface."
        },
        "filler_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "Thickness of the top and filler layers."
        },
        "underwater": {
          "$ref": "#/$defs/blocks",
          "description": "Top blocks under water or lava."
        },
        "snow": {
          "$ref": "#/$defs/snow",
          "description": "Where snow and ice may form in this biome; overrides snow of map.json."
        },
        "features": {
          "$ref": "#/$defs/features",
          "description": "Biome features in this biome; overrides decoration.features of map.json."
        },
        "carvers": {
          "$ref": "#/$defs/carvers",
          "description": "Carvers in this biome; overrides decoration.carvers of map.json."
        }
      }
    },
    "entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/resource_id"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "biome"
          ],
          "properties": {
            "biome": {
              "$ref": "#/$defs/resource_id"
            },
            "top": {
              "$ref": "#/$defs/blocks",
              "description": "Surface blocks."
            },
            "filler": {
              "$ref": "#/$defs/blocks",
              "description": "Blocks under the surface."
            },
            "filler_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "description": "Thickness of the top and filler layers."
            },
            "underwater": {
              "$ref": "#/$defs/blocks",
              "description": "Top blocks under water or lava."
            },
            "biome_river": {
              "$ref": "#/$defs/substitute",
              "description": "Used where the water map puts water over the ground, and on the land within river_width blocks of that water."
            },
            "biome_mountain": {
              "$ref": "#/$defs/substitute",
              "description": "Used where the ground is at or above mountain_y."
            },
            "biome_border": {
              "$ref": "#/$defs/substitute",
              "description": "Used within border_width blocks of another biome."
            },
            "biome_underground": {
              "$ref": "#/$defs/resource_id",
              "description": "Used underground, from underground_depth blocks below the ground."
            },
            "river_width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "default": 4,
              "description": "Width of the land around the water that also uses biome_river, in blocks. 0 for the water only."
            },
            "border_width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 4,
              "description": "Width of the biome_border band, in blocks."
            },
            "mountain_y": {
              "type": "integer",
              "description": "Ground Y from which biome_mountain is used. Default: sea_level + 64."
            },
            "underground_depth": {
              "type": "integer",
              "minimum": 0,
              "default": 16,
              "description": "Depth below the ground where biome_underground starts."
            },
            "snow": {
              "$ref": "#/$defs/snow",
              "description": "Where snow and ice may form in this biome; overrides snow of map.json."
            },
            "features": {
              "$ref": "#/$defs/features",
              "description": "Biome features in this biome; overrides decoration.features of map.json."
            },
            "carvers": {
              "$ref": "#/$defs/carvers",
              "description": "Carvers in this biome; overrides decoration.carvers of map.json."
            }
          }
        }
      ]
    },
    "snow": {
      "description": "Where snow layers and ice may form. Snow still needs a biome cold enough at that height: this only removes snow.",
      "oneOf": [
        {
          "type": "boolean",
          "description": "true: snow wherever the biome is cold enough. false: no snow and no ice."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_y": {
              "type": "integer",
              "description": "Lowest Y with snow."
            },
            "max_y": {
              "type": "integer",
              "description": "Highest Y with snow."
            }
          }
        }
      ]
    },
    "block_choice": {
      "oneOf": [
        {
          "$ref": "#/$defs/resource_id"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block"
          ],
          "properties": {
            "block": {
              "$ref": "#/$defs/resource_id"
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 1,
              "description": "Relative probability. A plain block id has a weight of 1."
            }
          }
        }
      ]
    },
    "blocks": {
      "description": "A block id, a list of blocks picked at random (with optional weights), or {\"blocks\": [...], \"method\": ...}.",
      "oneOf": [
        {
          "$ref": "#/$defs/resource_id"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block_choice"
          },
          "description": "Blocks picked at random for each position."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocks"
          ],
          "properties": {
            "blocks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/block_choice"
              }
            },
            "method": {
              "enum": [
                "random",
                "perlin"
              ],
              "default": "random",
              "description": "random: each block picked independently. perlin: smooth noise, the blocks form patches about scale blocks wide."
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 16,
              "description": "Size of the perlin patches, in blocks."
            }
          }
        }
      ]
    },
    "features": {
      "description": "Biome features (trees, grass, ores, lakes...): true, false, or a filter.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "disabled": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource_id"
              },
              "description": "Placed features to skip, e.g. minecraft:lake_lava_surface."
            },
            "disabled_steps": {
              "type": "array",
              "items": {
                "enum": [
                  "raw_generation",
                  "lakes",
                  "local_modifications",
                  "underground_structures",
                  "surface_structures",
                  "strongholds",
                  "underground_ores",
                  "underground_decoration",
                  "fluid_springs",
                  "vegetal_decoration",
                  "top_layer_modification"
                ]
              },
              "description": "Generation steps to skip entirely, e.g. lakes."
            },
            "only": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resource_id"
              },
              "description": "If set, only these placed features are generated."
            }
          }
        }
      ]
    },
    "carvers": {
      "description": "Caves and ravines from the biomes: true, false, or {\"cave\": ..., \"canyon\": ..., \"noise\": ..., \"surface\": ...}.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cave": {
              "type": "boolean",
              "default": true,
              "description": "Caves (and nether caves)."
            },
            "canyon": {
              "type": "boolean",
              "default": true,
              "description": "Ravines."
            },
            "noise": {
              "type": "boolean",
              "description": "Noise caves: large caverns, spaghetti and noodle caves, cave entrances. Defaults to the value of cave."
            },
            "surface": {
              "type": "boolean",
              "default": true,
              "description": "Whether the caves may open on the ground of the map. false: at least 8 blocks of ground are kept above them."
            }
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^(#|0x)?[0-9A-Fa-f]{6}$": {
      "$ref": "#/$defs/entry"
    },
    "^ *(?:25[0-5]|2[0-4]\\d|1\\d\\d|0?\\d?\\d) *, *(?:25[0-5]|2[0-4]\\d|1\\d\\d|0?\\d?\\d) *, *(?:25[0-5]|2[0-4]\\d|1\\d\\d|0?\\d?\\d) *$": {
      "$ref": "#/$defs/entry"
    }
  },
  "additionalProperties": false
}
